\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Long-run shell stability ($5\times 10^4$ steps, no seed, gradient-dependent transport). \textit  {Left:} Interior/exterior ratio vs step, with exponential fit $r(t) = 0.1285\,e^{-t/8621} + 1.021$. The plateau $C = 1.021 > 1$ confirms the shell does not dissolve. \textit  {Right:} Decay rate ($\Delta r$ per snapshot) approaching zero, confirming the system is stabilizing rather than continuing to decay.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:longrun}{{1}{5}{Long-run shell stability ($5\times 10^4$ steps, no seed, gradient-dependent transport). \textit {Left:} Interior/exterior ratio vs step, with exponential fit $r(t) = 0.1285\,e^{-t/8621} + 1.021$. The plateau $C = 1.021 > 1$ confirms the shell does not dissolve. \textit {Right:} Decay rate ($\Delta r$ per snapshot) approaching zero, confirming the system is stabilizing rather than continuing to decay}{figure.1}{}}
